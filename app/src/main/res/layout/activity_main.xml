<!-- Premium Glass Login Box -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cyber_panel"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:elevation="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ SYSTEM ACCESS ]"
        android:textColor="#FF0000"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="License Verification"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="22sp"
        android:shadowColor="#FF0000"
        android:shadowRadius="10"
        android:layout_marginBottom="4dp"/>
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your valid license to continue"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"/>

    <!-- Input Field with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_red_input"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑"
            android:textSize="18sp"
            android:layout_marginEnd="10dp"/>

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter License Key..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@android:color/transparent"
            android:textSize="14sp"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword"/>
    </LinearLayout>

    <!-- Glowing Launch Button -->
    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🚀 LAUNCH"
        android:background="@drawable/bg_red_button"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        android:shadowColor="#FF0000"
        android:shadowRadius="15"/>

    <!-- Bottom Status text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="> SECURE CONNECTION ESTABLISHED"
        android:textColor="#00FF00"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginTop="20dp"/>
</LinearLayout>
