<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020202">

    <!-- 🩸 MATRIX RAIN BACKGROUND (Naya Premium Look) -->
    <com.teamjadugar.apk.MatrixRainView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/imgLoginBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        android:src="@drawable/bg_login_screen"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/imgDashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        android:src="@drawable/bg_dashboard"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:windowSoftInputMode="adjustResize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= LOGIN SECTION ================= -->
            <LinearLayout
                android:id="@+id/layoutLogin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- Top Badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:padding="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textColor="#FF0000"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premium" android:textColor="#FFFFFF" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version v3.0.0" android:textColor="#888888" android:textSize="8sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:padding="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#00FF00" android:layout_marginEnd="8dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server Status" android:textColor="#FFFFFF" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textColor="#00FF00" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="80dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AETH DDOS"
                    android:textColor="#FF0000"
                    android:textSize="42sp"
                    android:textStyle="bold|italic"
                    android:shadowColor="#FF0000"
                    android:shadowRadius="40"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="U N L O C K  •  A C C E S S  •  C O N T R O L"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="30dp"/>

                <!-- Login Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="License Verification"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter your valid license to continue"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginBottom="20dp"/>

                    <EditText
                        android:id="@+id/etKey"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="🔑 Enter License Key..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:paddingStart="16dp"
                        android:background="@drawable/bg_red_input"
                        android:layout_marginBottom="20dp"
                        android:imeOptions="actionDone"/>

                    <Button
                        android:id="@+id/btnVerify"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="🚀 LAUNCH"
                        android:background="@drawable/bg_red_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"/>
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="40dp"/>
            </LinearLayout>

            <!-- ================= DASHBOARD SECTION ================= -->
            <LinearLayout
                android:id="@+id/layoutDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="end">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cyber_panel"
                        android:padding="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textColor="#FFD700"/>
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premium User" android:textColor="#00FF00" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvDashboardExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#FFFFFF" android:textSize="8sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AETH DDOS"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold|italic"
                    android:shadowColor="#FF0000"
                    android:shadowRadius="30"
                    android:layout_gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H a c k  •  A c c e s s  •  C o n t r o l"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- 🩸 ECG LIVE GRAPH (Naya Premium Look) -->
                <com.teamjadugar.apk.EcgView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Timer Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟢 PANEL ACTIVE" android:textColor="#00FF00" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                        <TextView android:id="@+id/tvDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold" android:fontFamily="monospace"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvHours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold" android:fontFamily="monospace"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvMins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold" android:fontFamily="monospace"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvSecs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="32sp" android:textStyle="bold" android:fontFamily="monospace"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ Time Remaining" android:textColor="#FFFFFF" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Info Boxes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="18sp"/>
                        <TextView android:id="@+id/tvSlots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/10" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Slots" android:textColor="#FF0000" android:textSize="10sp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="18sp"/>
                        <TextView android:id="@+id/tvDeviceId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SM-7492" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device ID" android:textColor="#FF0000" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Launch Floating -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚀" android:textSize="24sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launch Floating Panel" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Click to Start Your Panel" android:textColor="#888888" android:textSize="10sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/switchFloating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="#FFFFFF" android:trackTint="#FF0000"/>
                </LinearLayout>

                <!-- System Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System Info" android:textColor="#FF0000" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="👑 Plan Type" android:textColor="#FFFFFF" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvPlanType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=": Premium" android:textColor="#FFD700" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📅 Expiry Date" android:textColor="#FFFFFF" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvExpiryDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=": Loading..." android:textColor="#00FF00" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⚡ Status" android:textColor="#FFFFFF" android:textSize="11sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=": Active ✅" android:textColor="#00FF00" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="4"
                    android:layout_marginBottom="10dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_cyber_panel">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="20sp" android:textColor="#FF0000"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textColor="#FF0000" android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_cyber_panel"
                        android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp" android:textColor="#888888"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Analytics" android:textColor="#888888" android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_cyber_panel"
                        android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️" android:textSize="20sp" android:textColor="#888888"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Security" android:textColor="#888888" android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_cyber_panel"
                        android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎧" android:textSize="20sp" android:textColor="#888888"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Support" android:textColor="#888888" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POWERED BY AETH TEAM"
                    android:textColor="#FF0000"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"/>
                    
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
