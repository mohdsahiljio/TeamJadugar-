<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050000">

    <!-- 🩸 BACKGROUND GLOW (Peeche ka Red Effect) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:background="@drawable/bg_red_glow"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- ================= LOGIN SECTION ================= -->
            <LinearLayout
                android:id="@+id/layoutLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="40dp">

                <!-- Hacker Image (Agar tera paas koi image hai toh yahan daal) -->
                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:src="@drawable/ic_launcher"
                    app:tint="#FF0000"
                    android:layout_marginBottom="20dp"
                    android:shadowColor="#FF0000"
                    android:shadowRadius="30"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPECTRE API"
                    android:textColor="#FFFFFF"
                    android:textSize="42sp"
                    android:textStyle="bold|italic"
                    android:shadowColor="#FF0000"
                    android:shadowRadius="40"
                    android:letterSpacing="0.1"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCK • ACCESS • CONTROL"
                    android:textColor="#FF4444"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.3"
                    android:layout_marginBottom="40dp"/>

                <!-- Premium Glass Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_red_glass_card"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:elevation="25dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️ LICENSE VERIFICATION"
                        android:textColor="#FF0000"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="monospace"
                        android:shadowColor="#FF0000"
                        android:shadowRadius="10"
                        android:layout_marginBottom="10dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter your valid license to continue"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:layout_marginBottom="20dp"/>

                    <EditText
                        android:id="@+id/etKey"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:hint=">_ Enter License Key..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:background="@drawable/bg_red_input"
                        android:layout_marginBottom="24dp"/>

                    <Button
                        android:id="@+id/btnVerify"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:text="🚀 LAUNCH"
                        android:background="@drawable/bg_red_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:shadowColor="#FF0000"
                        android:shadowRadius="15"
                        android:elevation="15dp"/>
                </LinearLayout>
                
                <!-- Bottom Features (Icons) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_evenly"
                    android:layout_marginTop="30dp">
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡\nUltra Fast" android:textColor="#AAAAAA" android:textSize="10sp" android:gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️\nMilitary Grade" android:textColor="#AAAAAA" android:textSize="10sp" android:gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐\nGlobal Access" android:textColor="#AAAAAA" android:textSize="10sp" android:gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑\nPremium Tool" android:textColor="#AAAAAA" android:textSize="10sp" android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= DASHBOARD SECTION ================= -->
            <!-- (Ye waisa hi rahega, bas colors red ho jayenge) -->
            <LinearLayout
                android:id="@+id/layoutDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="20dp">
                
                <!-- Yahan tera dashboard ka code aayega (Jo hum agle step me red theme me banayenge) -->
                
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
