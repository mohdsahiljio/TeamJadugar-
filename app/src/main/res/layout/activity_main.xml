<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020202">

    <!-- Backgrounds -->
    <ImageView
        android:id="@+id/imgLoginBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login_screen"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/imgDashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        android:src="@drawable/bg_dashboard"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= LOGIN SECTION ================= -->
            <LinearLayout
                android:id="@+id/layoutLogin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- Top Badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:padding="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textColor="#FF0000"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premium" android:textColor="#FFFFFF" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version v3.0.0" android:textColor="#888888" android:textSize="8sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:padding="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#00FF00" android:layout_marginEnd="8dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server Status" android:textColor="#FFFFFF" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ONLINE" android:textColor="#00FF00" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="60dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AETH DDOS"
                    android:textColor="#FF0000"
                    android:textSize="42sp"
                    android:textStyle="bold|italic"
                    android:shadowColor="#FF0000"
                    android:shadowRadius="40"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="U N L O C K  •  A C C E S S  •  C O N T R O L"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="30dp"/>

                <!-- Premium Login Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[ SYSTEM ACCESS ]"
                        android:textColor="#FF0000"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="License Verification"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:shadowColor="#FF0000"
                        android:shadowRadius="10"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter your valid license to continue"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginBottom="24dp"/>

                    <!-- Input Field with Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_red_input"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔑"
                            android:textSize="18sp"
                            android:layout_marginEnd="10dp"/>

                        <EditText
                            android:id="@+id/etKey"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Enter License Key..."
                            android:textColor="#FFFFFF"
                            android:textColorHint="#555555"
                            android:background="@android:color/transparent"
                            android:textSize="14sp"
                            android:imeOptions="actionDone"
                            android:inputType="textVisiblePassword"/>
                    </LinearLayout>

                    <!-- Glowing Launch Button -->
                    <Button
                        android:id="@+id/btnVerify"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="🚀 LAUNCH"
                        android:background="@drawable/bg_red_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:letterSpacing="0.1"
                        android:shadowColor="#FF0000"
                        android:shadowRadius="15"/>

                    <!-- Bottom Status text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="> SECURE CONNECTION ESTABLISHED"
                        android:textColor="#00FF00"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="20dp"/>
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="40dp"/>
            </LinearLayout>

            <!-- ================= DASHBOARD SECTION ================= -->
            <LinearLayout
                android:id="@+id/layoutDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp">

                <!-- Premium User Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="end">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cyber_panel"
                        android:padding="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👑" android:textColor="#FFD700"/>
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premium User" android:textColor="#00FF00" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvDashboardExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#FFFFFF" android:textSize="8sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AETH DDOS"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold|italic"
                    android:shadowColor="#FF0000"
                    android:shadowRadius="30"
                    android:layout_gravity="center"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H a c k  •  A c c e s s  •  C o n t r o l"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Premium Timer Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟢 PANEL ACTIVE" android:textColor="#00FF00" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                        <TextView android:id="@+id/tvDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:fontFamily="monospace" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                        <TextView android:id="@+id/tvHours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:fontFamily="monospace" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                        <TextView android:id="@+id/tvMins" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:fontFamily="monospace" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                        <TextView android:id="@+id/tvSecs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00" android:textColor="#FF0000" android:textSize="40sp" android:textStyle="bold" android:fontFamily="monospace" android:shadowColor="#FF0000" android:shadowRadius="15"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ Time Remaining" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Premium Info Boxes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="22sp"/>
                        <TextView android:id="@+id/tvSlots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/10" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:shadowColor="#FFFFFF" android:shadowRadius="10"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Slots" android:textColor="#FF0000" android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cyber_panel"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="22sp"/>
                        <TextView android:id="@+id/tvDeviceId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SM-7492" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device ID" android:textColor="#FF0000" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Launch Floating Panel Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launch Floating Panel" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slide to activate" android:textColor="#888888" android:textSize="10sp" android:layout_marginBottom="12dp"/>
                    
                    <SeekBar android:id="@+id/sliderFloating" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" android:progressTint="#FF0000" android:thumbTint="#FF0000"/>
                </LinearLayout>

                <!-- Enter Game Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter Game" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slide right to open BGMI" android:textColor="#888888" android:textSize="10sp" android:layout_marginBottom="12dp"/>
                    
                    <SeekBar android:id="@+id/sliderGame" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" android:progressTint="#00FF00" android:thumbTint="#00FF00"/>
                </LinearLayout>

                <!-- System Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System Info" android:textColor="#FF0000" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="👑 Plan Type" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvPlanType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=": Premium" android:textColor="#FFD700" android:textSize="12sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📅 Expiry Date" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvExpiryDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=": Loading..." android:textColor="#00FF00" android:textSize="12sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⚡ Status" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=": Active ✅" android:textColor="#00FF00" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
