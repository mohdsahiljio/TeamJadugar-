<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 🩸 BACKGROUND ANIMATION (Peeche) -->
    <com.teamjadugar.apk.HackerBackgroundView
        android:layout_width="330dp"
        android:layout_height="match_parent" />

    <!-- 🩸 MAIN UI (Aage) -->
    <LinearLayout
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_launcher" android:layout_marginEnd="12dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPECTRE API" android:textColor="#00E5FF" android:textStyle="bold" android:textSize="18sp" android:fontFamily="monospace" android:shadowColor="#00E5FF" android:shadowRadius="15"/>
                <TextView android:id="@+id/tvSlots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SLOTS: 0/10" android:textColor="#20ef65" android:textSize="10sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView android:id="@+id/btnMinimize" android:layout_width="30dp" android:layout_height="30dp" android:text="—" android:gravity="center" android:textColor="#FFFFFF" android:textSize="20sp"/>
            <TextView android:id="@+id/btnClose" android:layout_width="30dp" android:layout_height="30dp" android:text="✕" android:gravity="center" android:textColor="#FF003C" android:textStyle="bold" android:textSize="20sp"/>
        </LinearLayout>

        <!-- TARGET IP -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:background="@drawable/bg_cyber_input" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐" android:textSize="18sp" android:layout_marginEnd="12dp"/>
            <EditText android:id="@+id/fEtIp" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="TARGET IP" android:textColor="#00E5FF" android:textColorHint="#555555" android:textSize="15sp" android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- TARGET PORT -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:background="@drawable/bg_cyber_input" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔢" android:textSize="18sp" android:layout_marginEnd="12dp"/>
            <EditText android:id="@+id/fEtPort" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="TARGET PORT" android:textColor="#00E5FF" android:textColorHint="#555555" android:textSize="15sp" android:fontFamily="monospace" android:inputType="number"/>
        </LinearLayout>

        <!-- DURATION SLIDER -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ATTACK DURATION:" android:textColor="#AAAAAA" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace"/>
            <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120s" android:textColor="#FF003C" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace"/>
        </LinearLayout>

        <SeekBar android:id="@+id/fSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="270" android:progress="90" android:progressTint="#FF003C" android:thumbTint="#FF003C" android:layout_marginBottom="20dp"/>

        <!-- ACTION BUTTONS -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <Button android:id="@+id/fBtnGetIp" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="GET IP" android:background="@drawable/bg_cyber_input" android:textColor="#00E5FF" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/fBtnVpnOff" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="VPN OFF" android:background="@drawable/bg_cyber_input" android:textColor="#FF003C" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- LAUNCH BUTTON -->
        <Button android:id="@+id/fBtnAttack" android:layout_width="match_parent" android:layout_height="65dp" android:text="🚀 LAUNCH ATTACK" android:background="@drawable/bg_cyber_button" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:fontFamily="monospace" android:elevation="12dp"/>

        <!-- FOOTER -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_cyber_input" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:layout_marginTop="16dp">
            <TextView android:id="@+id/tvLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="> STATUS: AUTHORIZED" android:textColor="#20ef65" android:textSize="10sp" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
