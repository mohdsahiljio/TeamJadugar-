<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_panel">

    <!-- Header / Drag Area & Close Button -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_red_input"/>
    </LinearLayout>

    <!-- TARGET IP -->
    <TextView
        android:id="@+id/lblIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TARGET IP"
        android:textColor="#FF0000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="48dp"
        android:layout_marginTop="25dp"/>

    <EditText
        android:id="@+id/fEtIp"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@android:color/transparent"
        android:hint="e.g. 192.168.1.1"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:paddingHorizontal="55dp"
        android:textSize="13sp"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="@id/lblIp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="-15dp"/>

    <!-- TARGET PORT -->
    <TextView
        android:id="@+id/lblPort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TARGET PORT"
        android:textColor="#FF0000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/fEtIp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="48dp"
        android:layout_marginTop="25dp"/>

    <EditText
        android:id="@+id/fEtPort"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@android:color/transparent"
        android:hint="e.g. 80"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:paddingHorizontal="55dp"
        android:textSize="13sp"
        android:inputType="number"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="@id/lblPort"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="-15dp"/>

    <!-- DURATION -->
    <LinearLayout
        android:id="@+id/durationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/fEtPort"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ATTACK DURATION"
            android:textColor="#FF0000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/fTvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 s"
            android:textColor="#FF0000"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="290"
        android:progress="50"
        android:progressTint="#FF0000"
        android:thumbTint="#FF0000"
        app:layout_constraintTop_toBottomOf="@id/durationLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="5dp"/>

    <!-- GET IP / VPN OFF -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/fSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/fBtnGetIp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="GET IP"
            android:background="@android:color/transparent"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/fBtnVpnOff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="VPN OFF"
            android:background="@android:color/transparent"
            android:textColor="#FF0000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- LAUNCH BUTTON -->
    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="LAUNCH ATTACK"
        android:background="@android:color/transparent"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/buttonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"/>

    <!-- ATTACK LOG -->
    <LinearLayout
        android:id="@+id/logLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/fBtnAttack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ATTACK LOG"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="invisible"/>

            <TextView
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEAR"
                android:textColor="#888888"
                android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> SPECTRE API v1.0\n> Ready."
            android:textColor="#00FF00"
            android:textSize="11sp"
            android:fontFamily="monospace"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
