<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:maxHeight="550dp" 
    android:scrollbars="none"
    android:background="@drawable/bg_red_glass_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🩸 HEADER (Logo aur Close Button) -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SPECTRE API"
                android:textColor="#FF0000"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:shadowColor="#FF0000"
                android:shadowRadius="10"/>

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="—"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
            
            <TextView
                android:id="@+id/btnClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="✕"
                android:gravity="center"
                android:textColor="#FF0000"
                android:textStyle="bold"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- 🩸 TARGET IP -->
        <EditText
            android:id="@+id/fEtIp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_red_input"
            android:hint="TARGET IP"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="10dp"/>

        <!-- 🩸 TARGET PORT -->
        <EditText
            android:id="@+id/fEtPort"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_red_input"
            android:hint="TARGET PORT"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- 🩸 SLOTS DISPLAY -->
        <TextView
            android:id="@+id/tvSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SLOTS: 0/10"
            android:textColor="#FF0000"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- 🩸 DURATION SLIDER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ATTACK DURATION:"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
            <TextView
                android:id="@+id/fTvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120s"
                android:textColor="#FF0000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/fSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="270"
            android:progress="90"
            android:progressTint="#FF0000"
            android:thumbTint="#FF0000"
            android:layout_marginBottom="16dp"/>

        <!-- 🩸 BUTTONS (GET IP, VPN OFF) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/fBtnGetIp"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="GET IP"
                android:background="@drawable/bg_red_input"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginEnd="5dp"/>
            <Button
                android:id="@+id/fBtnVpnOff"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="VPN OFF"
                android:background="@drawable/bg_red_input"
                android:textColor="#FF4444"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginStart="5dp"/>
        </LinearLayout>

        <!-- 🩸 LAUNCH BUTTON (Bada) -->
        <Button
            android:id="@+id/fBtnAttack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🚀 LAUNCH ATTACK"
            android:background="@drawable/bg_red_button"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:shadowColor="#FF0000"
            android:shadowRadius="15"
            android:elevation="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- 🩸 LOG AREA -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> STATUS: AUTHORIZED"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"/>
    </LinearLayout>
</ScrollView>
