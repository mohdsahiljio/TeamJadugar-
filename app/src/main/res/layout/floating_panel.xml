<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:maxHeight="550dp"
    android:scrollbars="none"
    android:background="@drawable/bg_red_glass_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#0A0505">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_launcher" app:tint="@color/neon_red" android:layout_marginEnd="8dp"/>
            
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPECTRE API" android:textColor="@color/neon_red" android:textStyle="bold" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONTROL > DISRUPT" android:textColor="@color/text_grey" android:textSize="7sp"/>
            </LinearLayout>
            
            <TextView android:id="@+id/btnClose" android:layout_width="28dp" android:layout_height="28dp" android:text="✕" android:gravity="center" android:textColor="@color/neon_red" android:textSize="16sp" android:background="@drawable/bg_red_input"/>
        </LinearLayout>

        <!-- Target IP -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎯 TARGET IP" android:textColor="@color/text_white" android:textSize="10sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/fEtIp" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_red_input" android:hint="e.g. 192.168.1.1" android:textColor="@color/text_white" android:textColorHint="@color/text_grey" android:paddingHorizontal="10dp" android:textSize="12sp" android:layout_marginBottom="10dp"/>

        <!-- Target Port -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💾 TARGET PORT" android:textColor="@color/text_white" android:textSize="10sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/fEtPort" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_red_input" android:hint="e.g. 80" android:textColor="@color/text_white" android:textColorHint="@color/text_grey" android:paddingHorizontal="10dp" android:textSize="12sp" android:inputType="number" android:layout_marginBottom="12dp"/>

        <!-- Duration -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="2dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏱️ DURATION" android:textColor="@color/text_white" android:textSize="10sp"/>
            <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 s" android:textColor="@color/neon_red" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/fSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="290" android:progress="50" android:progressTint="@color/neon_red" android:thumbTint="@color/neon_red" android:layout_marginBottom="12dp"/>

        <!-- Get IP / VPN -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/fBtnGetIp" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="GET IP" android:background="@drawable/bg_red_input" android:textColor="@color/text_white" android:textSize="11sp" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/fBtnVpnOff" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="VPN OFF" android:background="@drawable/bg_red_input" android:textColor="@color/neon_red" android:textSize="11sp" android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Launch Btn -->
        <Button android:id="@+id/fBtnAttack" android:layout_width="match_parent" android:layout_height="48dp" android:text="🚀 LAUNCH ATTACK" android:background="@drawable/bg_red_button" android:textColor="@color/text_white" android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="12dp"/>

        <!-- Attack Log -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_red_input" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📄 ATTACK LOG" android:textColor="@color/text_white" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> SPECTRE API v1.0\n> Ready." android:textColor="#00FF00" android:textSize="9sp" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
