<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard"
    android:padding="16dp"
    android:elevation="12dp">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM JADUGAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLOTS: 0/10"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text=""
                    android:textColor="#EF4444"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="—"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="18sp"/>
    </LinearLayout>

    <EditText
        android:id="@+id/fEtIp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="TARGET IP"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="#1A102E"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/fEtPort"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="TARGET PORT"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="#1A102E"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:textSize="12sp"
        android:inputType="number"/>

    <TextView
        android:id="@+id/fTvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ATTACK DURATION: 120s"
        android:textColor="#A855F7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>
    
    <!-- SLIDER FIXED: Max 270 + 30 base = 300s -->
    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="270"
        android:progress="90"
        android:progressTint="#00E5FF"
        android:thumbTint="#00E5FF"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <Button
            android:id="@+id/fBtnGetIp"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="GET IP"
            android:backgroundTint="#1A102E"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/fBtnVpnOff"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="VPN OFF"
            android:backgroundTint="#1A102E"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="LAUNCH ATTACK 🚀"
        android:background="@drawable/glow_button"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:letterSpacing="0.05"
        android:elevation="10dp"/>

    <ImageView
        android:id="@+id/resizeHandle"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:src="@android:drawable/ic_menu_more"
        android:tint="#4B5563"
        android:scaleType="centerInside"
        android:layout_marginTop="8dp"/>
</LinearLayout>
