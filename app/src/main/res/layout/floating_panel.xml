<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:maxHeight="550dp"
    android:scrollbars="none"
    android:background="@drawable/bg_floating_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="30dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_launcher" app:tint="@color/neon_red" android:layout_marginEnd="12dp"/>
            
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPECTRE API" android:textColor="@color/neon_red" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONTROL > DISRUPT > DISAPPEAR" android:textColor="#888888" android:textSize="8sp"/>
            </LinearLayout>
            
            <TextView android:id="@+id/btnClose" android:layout_width="30dp" android:layout_height="30dp" android:text="✕" android:gravity="center" android:textColor="@color/neon_red" android:textSize="18sp" android:background="@drawable/bg_red_input"/>
        </LinearLayout>

        <!-- Target IP -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎯 TARGET IP" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/fEtIp" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_red_input" android:hint="e.g. 192.168.1.1" android:textColor="#FFFFFF" android:textColorHint="#888888" android:paddingHorizontal="12dp" android:textSize="13sp" android:layout_marginBottom="16dp"/>

        <!-- Target Port -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💾 TARGET PORT" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/fEtPort" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_red_input" android:hint="e.g. 80" android:textColor="#FFFFFF" android:textColorHint="#888888" android:paddingHorizontal="12dp" android:textSize="13sp" android:inputType="number" android:layout_marginBottom="16dp"/>

        <!-- Duration -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏱️ ATTACK DURATION" android:textColor="#FFFFFF" android:textSize="11sp"/>
            <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 s" android:textColor="@color/neon_red" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/fSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="290" android:progress="50" android:progressTint="@color/neon_red" android:thumbTint="@color/neon_red" android:layout_marginBottom="16dp"/>

        <!-- Get IP / VPN -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <Button android:id="@+id/fBtnGetIp" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:text="📍 GET IP" android:background="@drawable/bg_red_input" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/fBtnVpnOff" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:text="🛡️ VPN OFF" android:background="@drawable/bg_red_input" android:textColor="@color/neon_red" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Launch Btn -->
        <Button android:id="@+id/fBtnAttack" android:layout_width="match_parent" android:layout_height="55dp" android:text="🚀 LAUNCH ATTACK" android:background="@drawable/bg_red_button" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="20dp"/>

        <!-- Attack Log -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_red_input" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📄 ATTACK LOG" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLEAR" android:textColor="#888888" android:textSize="10sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="[14:27:01] SPECTRE API v1.0 initialized\n[14:27:01] Awaiting input...\n[14:27:05] Ready." android:textColor="#00FF00" android:textSize="10sp" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
