<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard"
    android:padding="16dp"
    android:elevation="12dp">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM JADUGAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvSlots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SLOTS: 0/10"
                android:textColor="#00E5FF"
                android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="—"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- TARGET INPUTS -->
    <EditText
        android:id="@+id/fEtIp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="TARGET IP"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="#1A102E"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/fEtPort"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="TARGET PORT"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="#1A102E"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:textSize="12sp"
        android:inputType="number"/>

    <!-- DURATION -->
    <TextView
        android:id="@+id/fTvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ATTACK DURATION: 120s"
        android:textColor="#A855F7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>
    
    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="240"
        android:progress="60"
        android:progressTint="#00E5FF"
        android:thumbTint="#00E5FF"
        android:layout_marginBottom="12dp"/>

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        
        <Button
            android:id="@+id/fBtnGetIp"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="GET IP"
            android:backgroundTint="#1A102E"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/fBtnVpnOff"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="VPN OFF"
            android:backgroundTint="#1A102E"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LAUNCH ATTACK 🚀"
        android:backgroundTint="#D946EF"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"/>

    <!-- LIVE TIMER LOG -->
    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> READY"
        android:textColor="#22C55E"
        android:fontFamily="monospace"
        android:layout_marginTop="10dp"
        android:textSize="11sp"
        android:gravity="center"/>

    <!-- RESIZE HANDLE -->
    <ImageView
        android:id="@+id/resizeHandle"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:src="@android:drawable/ic_menu_more"
        android:tint="#4B5563"
        android:scaleType="centerInside"
        android:layout_marginTop="5dp"/>
</LinearLayout>
