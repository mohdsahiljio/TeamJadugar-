<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Main Panel Background -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_red_glass_card"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Logo (Using your existing launcher icon with red tint) -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher"
                app:tint="@color/neon_red"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPECTRE API"
                    android:textColor="@color/neon_red"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTROL > DISRUPT > DISAPPEAR"
                    android:textColor="@color/text_grey"
                    android:textSize="8sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:gravity="center"
                android:textColor="@color/neon_red"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_red_input"/>
        </LinearLayout>

        <!-- TARGET IP SECTION -->
        <TextView
            android:id="@+id/lblIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 TARGET IP"
            android:textColor="@color/neon_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/fEtIp"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_red_input"
            android:hint="e.g. 192.168.1.1"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/text_grey"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:singleLine="true"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/lblIp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TARGET PORT SECTION -->
        <TextView
            android:id="@+id/lblPort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾 TARGET PORT"
            android:textColor="@color/neon_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/fEtIp"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/fEtPort"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_red_input"
            android:hint="e.g. 80"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/text_grey"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/lblPort"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ATTACK DURATION SECTION -->
        <LinearLayout
            android:id="@+id/durationLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/fEtPort">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱️ ATTACK DURATION"
                android:textColor="@color/neon_red"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/fTvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 s"
                android:textColor="@color/neon_red"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/fSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="290"
            android:progress="50"
            android:progressTint="@color/neon_red"
            android:thumbTint="@color/neon_red"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/durationLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- GET IP & VPN BUTTONS -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/fSeekBar">

            <Button
                android:id="@+id/fBtnGetIp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📍 GET IP"
                android:background="@drawable/bg_red_input"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/fBtnVpnOff"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🛡️ VPN OFF"
                android:background="@drawable/bg_red_input"
                android:textColor="@color/neon_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- LAUNCH ATTACK BUTTON -->
        <Button
            android:id="@+id/fBtnAttack"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="🚀 LAUNCH ATTACK"
            android:background="@drawable/bg_red_button"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/buttonLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ATTACK LOG SECTION -->
        <LinearLayout
            android:id="@+id/logLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:background="@drawable/bg_red_input"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/fBtnAttack"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📄 ATTACK LOG"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR"
                    android:textColor="@color/text_grey"
                    android:textSize="10sp"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[14:27:01] SPECTRE API v1.0 initialized\n[14:27:01] Awaiting input...\n[14:27:05] Ready."
                    android:textColor="#00FF00"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </ScrollView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
