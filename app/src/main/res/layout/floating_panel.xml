<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp"
    android:elevation="10dp">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALPHA // OVERLAY"
            android:textColor="#FBBF24"
            android:textStyle="bold"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:text="❌"
            android:gravity="center"
            android:textColor="#EF4444"
            android:textSize="18sp"/>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="12dp"/>

    <!-- TARGET ENDPOINT -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET ENDPOINT" android:textColor="#FBBF24" android:textSize="10sp" android:textStyle="bold"/>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <EditText
            android:id="@+id/fEtIp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:hint="20.235.54.175"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginEnd="5dp"
            android:inputType="text"/>
        <EditText
            android:id="@+id/fEtPort"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Port"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:inputType="number"/>
    </LinearLayout>

    <!-- SESSION DURATION -->
    <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SESSION DURATION: 120s" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="15dp"/>
    
    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="240"
        android:progress="60"
        android:progressTint="#FBBF24"
        android:thumbTint="#FBBF24"
        android:layout_marginTop="5dp"/>

    <!-- BUTTONS (GET IP / VPN OFF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp">
        
        <Button
            android:id="@+id/fBtnGetIp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="GET IP"
            android:backgroundTint="#1E1E1E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginEnd="5dp"/>
            
        <Button
            android:id="@+id/fBtnVpnOff"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="VPN OFF"
            android:backgroundTint="#1E1E1E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginStart="5dp"/>
    </LinearLayout>

    <!-- LAUNCH BUTTON -->
    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="LAUNCH 🚀"
        android:backgroundTint="#FBBF24"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="15dp"/>
        
    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> READY"
        android:textColor="#22C55E"
        android:fontFamily="monospace"
        android:layout_marginTop="10dp"
        android:textSize="12sp"/>

</LinearLayout>
