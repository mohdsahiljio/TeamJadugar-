<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card_purple"
    android:padding="20dp"
    android:elevation="25dp">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginEnd="12dp"/>
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECTRE API"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>
            <TextView
                android:id="@+id/tvSlots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SLOTS: 0/10"
                android:textColor="#21d9ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:text="—"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/bg_minimize_btn"/>
        
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="#FF2454"
            android:textStyle="bold"
            android:textSize="22sp"
            android:background="@drawable/bg_close_btn"/>
    </LinearLayout>

    <!-- TARGET IP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_input_purple"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="14dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#21d9ff" android:layout_marginEnd="14dp"/>
        <EditText android:id="@+id/fEtIp" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="TARGET IP" android:textColor="#FFFFFF" android:textColorHint="#93839f" android:textSize="15sp" android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- TARGET PORT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_input_purple"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#20ef65" android:layout_marginEnd="14dp"/>
        <EditText android:id="@+id/fEtPort" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="TARGET PORT" android:textColor="#FFFFFF" android:textColorHint="#93839f" android:textSize="15sp" android:fontFamily="monospace" android:inputType="number"/>
    </LinearLayout>

    <!-- DURATION SLIDER -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ATTACK DURATION" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120s" android:textColor="#e13cff" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="270"
        android:progress="90"
        android:progressTint="#c12aff"
        android:thumbTint="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <Button android:id="@+id/fBtnGetIp" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="⚡ GET IP" android:background="@drawable/bg_input_purple" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
        
        <Button android:id="@+id/fBtnVpnOff" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="🛡️ VPN OFF" android:background="@drawable/bg_input_purple" android:textColor="#FF2454" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- LAUNCH ATTACK BUTTON -->
    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="🚀 LAUNCH ATTACK"
        android:background="@drawable/bg_button_purple"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:letterSpacing="0.08"
        android:elevation="15dp"/>

    <!-- FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_purple"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginTop="20dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="● Authorized  |  Ready for Load Testing" android:textColor="#20ef65" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textColor="#20ef65" android:textSize="13sp" android:gravity="center" android:textStyle="bold"/>
</LinearLayout>
