<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@drawable/bg_premium_card_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_launcher" app:tint="#FF1744" android:layout_marginEnd="8dp"/>
            
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AETH DDOS" android:textColor="#FF1744" android:textStyle="bold" android:textSize="16sp" android:shadowColor="#FF1744" android:shadowRadius="8"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONTROL > DISRUPT" android:textColor="#888888" android:textSize="8sp"/>
            </LinearLayout>

            <!-- Slots Display -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SLOTS" android:textColor="#888888" android:textSize="8sp"/>
                <TextView android:id="@+id/tvSlots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/10" android:textColor="#00FF00" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
            
            <TextView android:id="@+id/btnMinimize" android:layout_width="28dp" android:layout_height="28dp" android:text="—" android:gravity="center" android:textColor="#FF1744" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/bg_premium_input" android:layout_marginEnd="6dp"/>
            
            <TextView android:id="@+id/btnClose" android:layout_width="28dp" android:layout_height="28dp" android:text="✕" android:gravity="center" android:textColor="#FF1744" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_premium_input"/>
        </LinearLayout>

        <!-- Inputs -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎯 TARGET IP" android:textColor="#FF1744" android:textSize="10sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/fEtIp" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_premium_input" android:hint="e.g. 192.168.1.1" android:textColor="#FFFFFF" android:textColorHint="#555555" android:paddingHorizontal="12dp" android:textSize="12sp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💾 TARGET PORT" android:textColor="#FF1744" android:textSize="10sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/fEtPort" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_premium_input" android:hint="e.g. 80" android:textColor="#FFFFFF" android:textColorHint="#555555" android:paddingHorizontal="12dp" android:textSize="12sp" android:inputType="number" android:layout_marginBottom="12dp"/>

        <!-- Duration -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏱️ DURATION" android:textColor="#FF1744" android:textSize="10sp"/>
            <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 s" android:textColor="#FF1744" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/fSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:progress="60" android:progressTint="#FF1744" android:thumbTint="#FF1744" android:layout_marginBottom="16dp"/>

        <!-- Buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <Button android:id="@+id/fBtnGetIp" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="GET IP" android:background="@drawable/bg_premium_input" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/fBtnVpnOff" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="VPN OFF" android:background="@drawable/bg_premium_input" android:textColor="#FF1744" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Glowing Launch Button -->
        <Button android:id="@+id/fBtnAttack" android:layout_width="match_parent" android:layout_height="50dp" android:text="🚀 LAUNCH ATTACK" android:background="@drawable/bg_red_button" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:letterSpacing="0.1" android:shadowColor="#FF0000" android:shadowRadius="15" android:layout_marginBottom="16dp"/>

        <!-- Log -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_premium_input" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTACK LOG" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> AETH DDOS v1.0 initialized\n> Ready." android:textColor="#00FF00" android:textSize="10sp" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
