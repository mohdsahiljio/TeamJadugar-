<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0A0F14"
    android:padding="16dp"
    android:elevation="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JADUGAR // CORE"
            android:textColor="#00FFCC"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"/>
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:text="X"
            android:gravity="center"
            android:textColor="#FF003C"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="#1A1F2B"/>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#00FFCC" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET ENDPOINT" android:textColor="#00FFCC" android:textSize="10sp" android:textStyle="bold"/>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <EditText
            android:id="@+id/fEtIp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:hint="IP ADDRESS"
            android:textColor="#FFFFFF"
            android:textColorHint="#4A5568"
            android:background="#141C26"
            android:padding="12dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="monospace"
            android:inputType="text"/>
        <EditText
            android:id="@+id/fEtPort"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="PORT"
            android:textColor="#FFFFFF"
            android:textColorHint="#4A5568"
            android:background="#141C26"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="number"/>
    </LinearLayout>

    <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PULSE DURATION: 120s" android:textColor="#00FFCC" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="16dp"/>
    
    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="240"
        android:progress="60"
        android:progressTint="#00FFCC"
        android:thumbTint="#00FFCC"
        android:layout_marginTop="6dp"/>

    <Button
        android:id="@+id/fBtnGetIp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="SCAN FOR IP"
        android:backgroundTint="#141C26"
        android:textColor="#00FFCC"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="EXECUTE"
        android:backgroundTint="#00FFCC"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginTop="12dp"/>

</LinearLayout>
