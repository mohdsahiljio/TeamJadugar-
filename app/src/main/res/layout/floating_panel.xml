<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@drawable/bg_floating_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="80dp"
        android:paddingBottom="80dp">

        <!-- Header Area (Empty space khali chhod diya taaki background ka SPECTRE API text dikhe) -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            
            <!-- Drag karne ke liye transparent view, kyunki background me logo/text already hai -->
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            
            <!-- Close Button -->
            <TextView android:id="@+id/btnClose" android:layout_width="32dp" android:layout_height="32dp" android:text="✕" android:gravity="center" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/bg_red_input"/>
        </LinearLayout>

        <!-- Target IP -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET IP" android:textColor="#FF0000" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/fEtIp" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_red_input" android:hint="e.g. 192.168.1.1" android:textColor="#FFFFFF" android:textColorHint="#666666" android:paddingHorizontal="12dp" android:textSize="13sp" android:layout_marginBottom="18dp"/>

        <!-- Target Port -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET PORT" android:textColor="#FF0000" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/fEtPort" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_red_input" android:hint="e.g. 80" android:textColor="#FFFFFF" android:textColorHint="#666666" android:paddingHorizontal="12dp" android:textSize="13sp" android:inputType="number" android:layout_marginBottom="18dp"/>

        <!-- Duration -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="2dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ATTACK DURATION" android:textColor="#FF0000" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/fTvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 s" android:textColor="#FF0000" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/fSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="290" android:progress="50" android:progressTint="#FF0000" android:thumbTint="#FF0000" android:layout_marginBottom="20dp"/>

        <!-- Get IP / VPN -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <Button android:id="@+id/fBtnGetIp" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:text="GET IP" android:background="@drawable/bg_red_input" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/fBtnVpnOff" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:text="VPN OFF" android:background="@drawable/bg_red_input" android:textColor="#FF0000" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Launch Btn -->
        <Button android:id="@+id/fBtnAttack" android:layout_width="match_parent" android:layout_height="55dp" android:text="LAUNCH ATTACK" android:background="@drawable/bg_red_button" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="20dp"/>

        <!-- Attack Log -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_red_input" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ATTACK LOG" android:textColor="#FF0000" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLEAR" android:textColor="#666666" android:textSize="10sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> SPECTRE API v1.0\n> Ready." android:textColor="#00FF00" android:textSize="11sp" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
