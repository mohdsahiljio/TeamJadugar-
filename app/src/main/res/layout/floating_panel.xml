<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_cyber_panel"
    android:padding="20dp"
    android:elevation="20dp">

    <!-- 🩸 DRAG & RESIZE BAR (Isko pakad kar window hilayega) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SPECTRE API"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:text="—"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="#FF003C"
            android:textStyle="bold"
            android:textSize="22sp"/>
    </LinearLayout>

    <!-- TARGET IP -->
    <EditText
        android:id="@+id/fEtIp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_cyber_input"
        android:hint="TARGET IP"
        android:textColor="#00E5FF"
        android:textColorHint="#555555"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"/>

    <!-- TARGET PORT -->
    <EditText
        android:id="@+id/fEtPort"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_cyber_input"
        android:hint="TARGET PORT"
        android:textColor="#00E5FF"
        android:textColorHint="#555555"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- SLOTS DISPLAY -->
    <TextView
        android:id="@+id/tvSlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SLOTS: 0/10"
        android:textColor="#20ef65"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- DURATION SLIDER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ATTACK DURATION:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>
        <TextView
            android:id="@+id/fTvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120s"
            android:textColor="#FF003C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/fSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="270"
        android:progress="90"
        android:progressTint="#FF003C"
        android:thumbTint="#FF003C"
        android:layout_marginBottom="20dp"/>

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button
            android:id="@+id/fBtnGetIp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="GET IP"
            android:background="@drawable/bg_cyber_input"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>
        <Button
            android:id="@+id/fBtnVpnOff"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="VPN OFF"
            android:background="@drawable/bg_cyber_input"
            android:textColor="#FF003C"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- LAUNCH BUTTON (PREMIUM LOOK) -->
    <Button
        android:id="@+id/fBtnAttack"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🚀 LAUNCH ATTACK"
        android:background="@drawable/bg_cyber_button"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:elevation="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- LOG AREA -->
    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="> STATUS: AUTHORIZED"
        android:textColor="#20ef65"
        android:textSize="10sp"
        android:fontFamily="monospace"/>
</LinearLayout>
