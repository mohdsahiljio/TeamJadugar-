<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:maxHeight="600dp"
    android:background="@drawable/bg_glass_card_purple"
    android:elevation="15dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <RelativeLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- Logo & Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPECTRE API"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"/>
                    <!-- Slots Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card_purple"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/tvSlots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SLOTS: 0/10"
                            android:textColor="#00E5FF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Minimize & Close -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnMinimize"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:text="—"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/btnClose"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:text="✕"
                    android:gravity="center"
                    android:textColor="#FF0000"
                    android:background="@drawable/bg_glass_card_purple"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- INPUTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_purple"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"/>
            <EditText
                android:id="@+id/fEtIp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="TARGET IP"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_purple"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📟"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"/>
            <EditText
                android:id="@+id/fEtPort"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="TARGET PORT"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp"
                android:inputType="number"/>
        </LinearLayout>

        <!-- SLIDER -->
        <TextView
            android:id="@+id/fTvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ATTACK DURATION: 120s"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        
        <SeekBar
            android:id="@+id/fSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="270"
            android:progress="90"
            android:progressTint="#B026FF"
            android:thumbTint="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            
            <Button
                android:id="@+id/fBtnGetIp"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="⚡ GET IP"
                android:background="@drawable/bg_glass_card_purple"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"/>
                
            <Button
                android:id="@+id/fBtnVpnOff"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="🛡️ VPN OFF"
                android:background="@drawable/bg_glass_card_purple"
                android:textColor="#FF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/fBtnAttack"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="🚀 LAUNCH ATTACK"
            android:background="@drawable/bg_button_purple"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:letterSpacing="0.05"
            android:elevation="10dp"/>

        <!-- BOTTOM BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_purple"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:layout_marginTop="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Authorized  |  Ready for Load Testing"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/stat_sys_signal_4"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:gravity="center"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
