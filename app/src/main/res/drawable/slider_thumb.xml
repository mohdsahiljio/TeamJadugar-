<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. Outer Deep Shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#DD000000" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>

    <!-- 2. Outer Chrome Ring (Silver Metallic) -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#555555"
                android:endColor="#111111" />
            <stroke android:width="1dp" android:color="#999999" />
        </shape>
    </item>

    <!-- 3. Inner Blood Red Core with Gradient -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF0000"
                android:centerColor="#880000"
                android:endColor="#220000" />
        </shape>
    </item>

    <!-- 4. Neon Glowing Arrow (Sharp & Aggressive) -->
    <item android:gravity="center">
        <vector android:width="26dp" android:height="26dp" android:viewportWidth="24" android:viewportHeight="24">
            <path
                android:fillColor="#FFFFFF"
                android:strokeColor="#FF0000"
                android:strokeWidth="1"
                android:pathData="M8,4 L18,12 L8,20 Z" />
        </vector>
    </item>
</layer-list>
