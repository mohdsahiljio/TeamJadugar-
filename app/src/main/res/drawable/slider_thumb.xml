<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#80000000" />
            <size android:width="50dp" android:height="50dp" />
        </shape>
    </item>
    <!-- Base Button -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#FF2222" android:endColor="#550000" />
            <stroke android:width="1.5dp" android:color="#FF6666" />
        </shape>
    </item>
    <!-- Inner Triangle Icon -->
    <item android:gravity="center">
        <vector android:width="20dp" android:height="20dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="#FFFFFF" android:pathData="M8,5 L16,12 L8,19 Z" />
        </vector>
    </item>
</layer-list>
