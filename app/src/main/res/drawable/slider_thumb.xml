<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#AA000000" />
            <size android:width="54dp" android:height="54dp" />
        </shape>
    </item>

    <!-- Chrome Metallic Ring -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#888888"
                android:endColor="#222222" />
        </shape>
    </item>

    <!-- Inner Deep Red Core -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF1111"
                android:centerColor="#880000"
                android:endColor="#330000" />
        </shape>
    </item>

    <!-- Play Arrow -->
    <item android:gravity="center">
        <vector android:width="18dp" android:height="18dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="#FFFFFF" android:pathData="M8,5 L16,12 L8,19 Z" />
        </vector>
    </item>
</layer-list>
