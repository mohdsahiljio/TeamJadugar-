<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#55FF0000" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
    <!-- Middle Ring -->
    <item android:bottom="4dp" android:top="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#11000000" />
            <stroke android:width="3dp" android:color="#FF0000" />
        </shape>
    </item>
    <!-- Inner Core -->
    <item android:bottom="12dp" android:top="12dp" android:left="12dp" android:right="12dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
