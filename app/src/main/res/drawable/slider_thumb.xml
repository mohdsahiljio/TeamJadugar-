
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Premium Red Neon Outer Glow -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="48dp"
                android:height="48dp" />
            <solid android:color="#33FF0000" />
        </shape>
    </item>

    <!-- Metallic Black Outer Border -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#080808" />
            <stroke
                android:width="2dp"
                android:color="#FF2020" />
        </shape>
    </item>

    <!-- Inner Red Neon Circle -->
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FF4545"
                android:centerColor="#D90000"
                android:endColor="#700000" />
            <stroke
                android:width="1dp"
                android:color="#FFFF7777" />
        </shape>
    </item>

    <!-- White Double Right Arrows -->
    <item
        android:gravity="center"
        android:width="25dp"
        android:height="25dp">
        <bitmap
            android:src="@android:drawable/ic_media_next"
            android:gravity="center"
            android:tint="#FFFFFFFF" />
    </item>

</layer-list>
