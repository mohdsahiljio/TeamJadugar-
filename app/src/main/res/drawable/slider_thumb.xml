<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer Dark Shadow (Depth ke liye) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#80000000" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>

    <!-- Outer Metallic Ring (Chrome effect) -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#888888"
                android:endColor="#222222" />
            <stroke android:width="1dp" android:color="#555555" />
        </shape>
    </item>

    <!-- Inner Blood Red Core -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF0000"
                android:centerColor="#990000"
                android:endColor="#330000" />
            <stroke android:width="1dp" android:color="#FF4444" />
        </shape>
    </item>

    <!-- Center Glowing Arrow Icon -->
    <item android:gravity="center">
        <vector android:width="20dp" android:height="20dp" android:viewportWidth="24" android:viewportHeight="24">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M8,5 L16,12 L8,19 Z" />
        </vector>
    </item>

</layer-list>
