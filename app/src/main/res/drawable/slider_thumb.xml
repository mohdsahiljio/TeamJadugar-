<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <size
                android:width="50dp"
                android:height="50dp" />
            <solid android:color="#55FF2020" />
        </shape>
    </item>

    <item android:inset="5dp">
        <shape android:shape="oval">
            <solid android:color="#FF151515" />
            <stroke
                android:width="2dp"
                android:color="#FFFF3030" />
        </shape>
    </item>

    <item android:inset="13dp">
        <shape android:shape="oval">
            <solid android:color="#FFFF3030" />
        </shape>
    </item>

</layer-list>
