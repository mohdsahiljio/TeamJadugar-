<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#AA000000" />
            <size android:width="60dp" android:height="50dp" />
        </shape>
    </item>
    
    <!-- Metallic Base (Sharp Rectangle) -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#FF2222" android:endColor="#550000" />
            <stroke android:width="2dp" android:color="#CCCCCC" />
        </shape>
    </item>

    <!-- Inner Red Core -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#AA0000" />
        </shape>
    </item>
</layer-list>
