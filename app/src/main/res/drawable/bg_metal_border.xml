<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Glow Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1A000000" />
            <stroke
                android:width="2dp"
                android:color="#FF1744" />
        </shape>
    </item>

    <!-- Inner Metallic Gradient -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#1F1F1F"
                android:centerColor="#0D0D0D"
                android:endColor="#000000" />
            <stroke
                android:width="1dp"
                android:color="#33FF0000" />
        </shape>
    </item>

</layer-list>
