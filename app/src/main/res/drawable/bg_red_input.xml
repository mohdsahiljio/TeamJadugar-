
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Red Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="#33000000"/>
            <stroke
                android:width="3dp"
                android:color="#FFFF1010"/>
        </shape>
    </item>

    <!-- Inner Dark Glass -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp">

        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#15101010"/>
            <stroke
                android:width="1dp"
                android:color="#99FF3030"/>
        </shape>
    </item>

</layer-list>
