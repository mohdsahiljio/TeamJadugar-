<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Metallic Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="270" android:startColor="#888888" android:centerColor="#333333" android:endColor="#111111" />
        </shape>
    </item>
    <!-- Inner Black Carbon Track -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#0A0A0A" />
            <!-- Subtle Red Glow inside -->
            <stroke android:width="1dp" android:color="#33FF0000" />
        </shape>
    </item>
</layer-list>
