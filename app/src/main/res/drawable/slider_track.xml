<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track Background (Sunken effect) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#0A0A0A"
                android:endColor="#1A1A1A" />
            <stroke android:width="1dp" android:color="#33000000" />
        </shape>
    </item>
    <!-- Progress (Glowing Neon Red) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#99000000"
                    android:centerColor="#FF1010"
                    android:endColor="#FF5555" />
                <stroke android:width="1dp" android:color="#FFFF8888" />
            </shape>
        </clip>
    </item>
</layer-list>
