
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background Track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#171717"/>
            <stroke
                android:width="1dp"
                android:color="#FF2525"/>
        </shape>
    </item>

    <!-- Secondary Progress -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/>
                <solid android:color="#99AA0000"/>
            </shape>
        </clip>
    </item>

    <!-- Main Red Progress -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/>
                <gradient
                    android:angle="0"
                    android:startColor="#FF660000"
                    android:centerColor="#FFFF0000"
                    android:endColor="#FFFF5555"/>
                <stroke
                    android:width="1dp"
                    android:color="#FFFF7777"/>
            </shape>
        </clip>
    </item>

</layer-list>
