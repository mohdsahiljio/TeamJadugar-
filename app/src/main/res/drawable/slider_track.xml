<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient android:angle="270" android:startColor="#0A0A0A" android:endColor="#1A1A1A" />
            <stroke android:width="1dp" android:color="#333333" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="25dp" />
                <gradient android:angle="0" android:startColor="#990000" android:centerColor="#FF0000" android:endColor="#FF4444" />
                <stroke android:width="1dp" android:color="#FF8888" />
            </shape>
        </clip>
    </item>
</layer-list>
