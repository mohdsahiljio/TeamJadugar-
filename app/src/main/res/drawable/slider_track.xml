
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OUTER METALLIC TRACK -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="#080808"/>
            <stroke
                android:width="2dp"
                android:color="#777777"/>
        </shape>
    </item>

    <!-- INNER BLACK GLASS TRACK -->
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <solid android:color="#080000"/>
            <stroke
                android:width="1.5dp"
                android:color="#FF1010"/>
        </shape>
    </item>

    <!-- CENTER RED CHEVRONS >>> -->
    <item android:gravity="center">

        <vector
            android:width="80dp"
            android:height="28dp"
            android:viewportWidth="100"
            android:viewportHeight="28">

            <path
                android:fillColor="#FF1010"
                android:pathData="M0,0 L7,0 L21,14 L7,28 L0,28 L14,14 Z"/>

            <path
                android:fillColor="#FF1010"
                android:pathData="M28,0 L35,0 L49,14 L35,28 L28,28 L42,14 Z"/>

            <path
                android:fillColor="#FF1010"
                android:pathData="M56,0 L63,0 L77,14 L63,28 L56,28 L70,14 Z"/>

        </vector>
    </item>

</layer-list>
