<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Metallic Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#111111" />
            <stroke android:width="1.5dp" android:color="#666666" />
        </shape>
    </item>
    <!-- Inner Black Track with Red Glow -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="0" android:startColor="#0A0A0A" android:endColor="#1A0000" />
        </shape>
    </item>
</layer-list>
