<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#80FF0000" />
        </shape>
    </item>
    <!-- Inner Glass Fill -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="135"
                android:startColor="#33FF0000"
                android:centerColor="#1A000000"
                android:endColor="#0D000000" />
            <stroke android:width="0.5dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
